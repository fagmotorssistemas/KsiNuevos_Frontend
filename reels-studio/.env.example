# Copia este archivo como .env y pon tus claves (las mismas que usa la app web en .env.local).
ASSEMBLYAI_API_KEY=
# Claude dirige los reels (plan creativo y ubicación de objetos).
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude (por defecto claude-opus-5-5; más barato: claude-sonnet-5-5).
# CLAUDE_DIRECTOR_MODEL=claude-opus-5-5

# Respaldo: Gemini como director (DIRECTOR_PROVIDER=gemini + GEMINI_API_KEY).
# DIRECTOR_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_DIRECTOR_MODEL=gemini-3.8-flash

# Opcional: en una computadora con tarjeta gráfica, "angle" renderiza el 3D más rápido.
# REMOTION_GL=angle
