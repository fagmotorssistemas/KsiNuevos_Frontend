# Copia este archivo como .env y pon tus claves (las mismas que usa la app web en .env.local).
ASSEMBLYAI_API_KEY=
# Claude como director (si está, se usa Claude salvo que DIRECTOR_PROVIDER diga otra cosa).
ANTHROPIC_API_KEY=
# Gemini: director, o solo la ubicación exacta de objetos cuando dirige Claude.
GEMINI_API_KEY=

# Opcional: forzar el director (claude | gemini).
# DIRECTOR_PROVIDER=claude
# Opcional: modelo de Claude (por defecto claude-opus-5-5; más barato: claude-sonnet-5-5).
# CLAUDE_DIRECTOR_MODEL=claude-opus-5-5
# Opcional: modelo de Gemini (por defecto gemini-3.8-flash).
# GEMINI_DIRECTOR_MODEL=gemini-3.1-pro-preview

# Opcional: en una computadora con tarjeta gráfica, "angle" renderiza el 3D más rápido.
# REMOTION_GL=angle
