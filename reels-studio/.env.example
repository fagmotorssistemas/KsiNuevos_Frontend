# Copia este archivo como .env y pon tus claves (las mismas que usa la app web en .env.local).
ASSEMBLYAI_API_KEY=
# Claude dirige los reels (identificación del vehículo, montaje y motion graphics).
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude para el montaje y para el motion graphics (por defecto claude-opus-5-5).
# CLAUDE_DIRECTOR_MODEL=claude-opus-5-5
# CLAUDE_MOTION_MODEL=claude-opus-5-5
# Opcional: esfuerzo del motion graphics (low | medium | high | xhigh | max; por defecto high).
# CLAUDE_MOTION_EFFORT=high
# Opcional: Chrome propio para renderizar (si no, HyperFrames usa el suyo: npm run hf:browser).
# HYPERFRAMES_BROWSER_PATH=
