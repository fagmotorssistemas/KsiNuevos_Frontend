# Copia este archivo como .env y pon tus claves (las mismas que usa la app web en .env.local).
GEMINI_API_KEY=
ASSEMBLYAI_API_KEY=

# Opcional: modelo de Gemini que dirige el Reel (por defecto gemini-3.8-flash).
# GEMINI_DIRECTOR_MODEL=gemini-3.1-pro-preview

# Opcional: en una computadora con tarjeta gráfica, "angle" renderiza el 3D más rápido.
# REMOTION_GL=angle
